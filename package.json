{
  "name": "productivity-tracker",
  "version": "1.0.0",
  "description": "Productivity tracker with automatic screen monitoring",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.productivity.tracker",
    "productName": "Productivity Tracker",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icon.png"
    },
    "files": [
      "**/*",
      "!README.md"
    ]
  },
  "dependencies": {
    "electron": "^28.0.0",
    "active-win": "^8.0.0",
    "mongodb": "^6.3.0"
  },
  "devDependencies": {
    "electron-builder": "^24.9.0"
  }
}